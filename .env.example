# =============================================================================
# ChoresRewards — runtime configuration
#
# Local Docker / compose :  copy to `.env` next to docker-compose.yml
# Coolify                :  paste these keys into the application's
#                           "Environment Variables" panel instead
# =============================================================================

# Port the Express server listens on.
# Coolify: must match the app's "Ports Exposes" setting (8099).
PORT=8099

# Postgres connection string (REQUIRED — the app has no SQLite fallback).
# Coolify: add a PostgreSQL resource, then paste its *internal* URL here or into
# the app's Environment Variables panel, e.g.
#   postgres://user:password@postgres-resource-uuid:5432/dbname
# docker compose (local): leave unset to use the bundled `db` service.
DATABASE_URL=

# How long a container keeps retrying a transient Postgres failure (DNS/EAI_AGAIN
# while the database container is still starting, a connection reset mid-migration)
# before the boot is declared failed. Keep it BELOW the health check's start period
# (60s in the Dockerfile) so a slow boot is never reported as an unhealthy
# container — Coolify judges the deploy on that single health status.
DB_BOOT_TIMEOUT_MS=45000

# Where uploads, the session secret and backup snapshots live.
# MUST be a persistent volume in production — in Coolify add a volume
# mounted at /data, otherwise that state is lost on redeploy.
DATA_DIR=/data

# Optional fine-grained override for the uploads root (defaults to DATA_DIR/uploads)
# UPLOADS_DIR=/data/uploads

# Session signing secret. When empty, one is generated into DATA_DIR/secret_key
# on first boot and reused afterwards.
#
# LEAVE THIS EMPTY when migrating with a backup: the archive carries the old
# `secret_key` and an explicit value here would OVERRIDE it (all devices would
# have to log in again). Only set it if you want a fixed key that survives a
# lost volume.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CR_SECRET_KEY=

# Household timezone fallback (still editable at runtime in Settings → General)
TZ=Australia/Brisbane

# Recipe/calendar web features: set to false to disable Google Calendar integration
ENABLE_GOOGLE_CALENDAR=true

# Override the version shown in the header (defaults to choresrewards/config.yaml)
# APP_VERSION=
