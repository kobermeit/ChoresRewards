{
  "name": "choresrewards",
  "version": "1.23.2",
  "private": true,
  "description": "Family Chores, Rewards & Household Hub (Node.js + Express + SQLite + React + Vite)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "verify": "node scripts/verify_ingress.js",
    "verify:deploy": "node scripts/verify_deploy.js",
    "start": "node scripts/start_app.js",
    "start:build": "node scripts/start_app.js --build",
    "stop": "docker compose stop",
    "docker:logs": "docker compose logs -f choresrewards",
    "install:all": "npm --prefix server install && npm --prefix client install"
  }
}
